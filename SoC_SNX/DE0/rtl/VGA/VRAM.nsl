#include "VGA_ctrl.inc"
/*
declare vram {
        input           address_a[12];
        input           address_b[12];
        input           data_a[16];
        input           data_b[16];
        output          q_a[16];
        output          q_b[16];
        func_in         wren_a();
        //func_in         wren_b();
}
*/

module  RAM2P_16x4K {
	mem vrammem[4096][16];
	reg	outA[16], outB[16];

	_readmemh("VRAM.hex", vrammem);

	func wren_a vrammem[address_a] := data_a;
	//func wren_b vrammem[address_b] := data_b;

	outA := vrammem[address_a];
	outB := vrammem[address_b];
	q_a=outA;
	q_b=outB;
}
