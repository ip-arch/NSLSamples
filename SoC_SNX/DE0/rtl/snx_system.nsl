// for 1cycle latency

#include "snx.h"
#include "snx_system.inc"

module snx_system {
	snx cpu;

	/* snx startup */ 
	{ 
	reg    stcount[16]=0xffff;
	if(stcount>0) stcount--;
	if(stcount==2) cpu.start();
	} 

	func cpu.memory_adr memory_read(cpu.adrs);
	func cpu.inst_adr memory_read(cpu.iadrs);
	func intr cpu.IntReq();

	alt {
		cpu.memory_read: {cpu.datai = datai; cpu.mem_ok();}
		cpu.memory_write: {memory_write(cpu.adrs,cpu.datao); cpu.mem_ok();}
		cpu.inst_read: {cpu.inst = datai; cpu.inst_ok();}
	}
}
