/*******************************************************************************
*GPIO: GPIO control module
********************************************************************************
* 2011.09.11   Initial version  by Y. Okuyama
* 2022.06.13   modified from LED  by N. Shimizu
*******************************************************************************/

#include "GPIO.inc"

module GPIO {
	reg		GPIO_0_i0[16] = 0;
	reg		GPIO_0_i1[16] = 0;
	reg		GPIO_0_i2[4] = 0;
	reg		GPIO_1_i0[16] = 0;
	reg		GPIO_1_i1[16] = 0;
	reg		GPIO_1_i2[4] = 0;
	reg		GPIO_0_d0[16] = 0;
	reg		GPIO_0_d1[16] = 0;
	reg		GPIO_0_d2[4] = 0;
	reg		GPIO_1_d0[16] = 0;
	reg		GPIO_1_d1[16] = 0;
	reg		GPIO_1_d2[4] = 0;

	function read {
		any {
			adrs==0b000: return GPIO_0[15:0];
			adrs==0b001: return GPIO_0[31:16];
			adrs==0b010: return 16'GPIO_0[35:31];
			adrs==0b100: return GPIO_1[15:0];
			adrs==0b101: return GPIO_1[31:16];
			adrs==0b110: return 16'GPIO_1[35:31];
		}
	}
	function write {
		any {
			adrs==0b000: GPIO_0_i0:=datai;
			adrs==0b001: GPIO_0_i1:=datai;
			adrs==0b010: GPIO_0_i2:=datai[3:0];
			adrs==0b100: GPIO_1_i0:=datai;
			adrs==0b101: GPIO_1_i1:=datai;
			adrs==0b110: GPIO_1_i2:=datai[3:0];
		}
	}
	function direction {
		any {
			adrs==0b000: GPIO_0_d0:=datai;
			adrs==0b001: GPIO_0_d1:=datai;
			adrs==0b010: GPIO_0_d2:=datai[3:0];
			adrs==0b100: GPIO_1_d0:=datai;
			adrs==0b101: GPIO_1_d1:=datai;
			adrs==0b110: GPIO_1_d2:=datai[3:0];
		}
	}

	GPIO_0 = {
		if(GPIO_0_d2[3]) GPIO_0_i2[3] else 0bz,
		if(GPIO_0_d2[2]) GPIO_0_i2[2] else 0bz,
		if(GPIO_0_d2[1]) GPIO_0_i2[1] else 0bz,
		if(GPIO_0_d2[0]) GPIO_0_i2[0] else 0bz,
		if(GPIO_0_d1[15]) GPIO_0_i1[15] else 0bz,
		if(GPIO_0_d1[14]) GPIO_0_i1[14] else 0bz,
		if(GPIO_0_d1[13]) GPIO_0_i1[13] else 0bz,
		if(GPIO_0_d1[12]) GPIO_0_i1[12] else 0bz,
		if(GPIO_0_d1[11]) GPIO_0_i1[11] else 0bz,
		if(GPIO_0_d1[10]) GPIO_0_i1[10] else 0bz,
		if(GPIO_0_d1[9]) GPIO_0_i1[9] else 0bz,
		if(GPIO_0_d1[8]) GPIO_0_i1[8] else 0bz,
		if(GPIO_0_d1[7]) GPIO_0_i1[7] else 0bz,
		if(GPIO_0_d1[6]) GPIO_0_i1[6] else 0bz,
		if(GPIO_0_d1[5]) GPIO_0_i1[5] else 0bz,
		if(GPIO_0_d1[4]) GPIO_0_i1[4] else 0bz,
		if(GPIO_0_d1[3]) GPIO_0_i1[3] else 0bz,
		if(GPIO_0_d1[2]) GPIO_0_i1[2] else 0bz,
		if(GPIO_0_d1[1]) GPIO_0_i1[1] else 0bz,
		if(GPIO_0_d1[0]) GPIO_0_i1[0] else 0bz,
		if(GPIO_0_d0[15]) GPIO_0_i0[15] else 0bz,
		if(GPIO_0_d0[14]) GPIO_0_i0[14] else 0bz,
		if(GPIO_0_d0[13]) GPIO_0_i0[13] else 0bz,
		if(GPIO_0_d0[12]) GPIO_0_i0[12] else 0bz,
		if(GPIO_0_d0[11]) GPIO_0_i0[11] else 0bz,
		if(GPIO_0_d0[10]) GPIO_0_i0[10] else 0bz,
		if(GPIO_0_d0[9]) GPIO_0_i0[9] else 0bz,
		if(GPIO_0_d0[8]) GPIO_0_i0[8] else 0bz,
		if(GPIO_0_d0[7]) GPIO_0_i0[7] else 0bz,
		if(GPIO_0_d0[6]) GPIO_0_i0[6] else 0bz,
		if(GPIO_0_d0[5]) GPIO_0_i0[5] else 0bz,
		if(GPIO_0_d0[4]) GPIO_0_i0[4] else 0bz,
		if(GPIO_0_d0[3]) GPIO_0_i0[3] else 0bz,
		if(GPIO_0_d0[2]) GPIO_0_i0[2] else 0bz,
		if(GPIO_0_d0[1]) GPIO_0_i0[1] else 0bz,
		if(GPIO_0_d0[0]) GPIO_0_i0[0] else 0bz
		};

	GPIO_1 = {
		if(GPIO_1_d2[3]) GPIO_1_i2[3] else 0bz,
		if(GPIO_1_d2[2]) GPIO_1_i2[2] else 0bz,
		if(GPIO_1_d2[1]) GPIO_1_i2[1] else 0bz,
		if(GPIO_1_d2[0]) GPIO_1_i2[0] else 0bz,
		if(GPIO_1_d1[15]) GPIO_1_i1[15] else 0bz,
		if(GPIO_1_d1[14]) GPIO_1_i1[14] else 0bz,
		if(GPIO_1_d1[13]) GPIO_1_i1[13] else 0bz,
		if(GPIO_1_d1[12]) GPIO_1_i1[12] else 0bz,
		if(GPIO_1_d1[11]) GPIO_1_i1[11] else 0bz,
		if(GPIO_1_d1[10]) GPIO_1_i1[10] else 0bz,
		if(GPIO_1_d1[9]) GPIO_1_i1[9] else 0bz,
		if(GPIO_1_d1[8]) GPIO_1_i1[8] else 0bz,
		if(GPIO_1_d1[7]) GPIO_1_i1[7] else 0bz,
		if(GPIO_1_d1[6]) GPIO_1_i1[6] else 0bz,
		if(GPIO_1_d1[5]) GPIO_1_i1[5] else 0bz,
		if(GPIO_1_d1[4]) GPIO_1_i1[4] else 0bz,
		if(GPIO_1_d1[3]) GPIO_1_i1[3] else 0bz,
		if(GPIO_1_d1[2]) GPIO_1_i1[2] else 0bz,
		if(GPIO_1_d1[1]) GPIO_1_i1[1] else 0bz,
		if(GPIO_1_d1[0]) GPIO_1_i1[0] else 0bz,
		if(GPIO_1_d0[15]) GPIO_1_i0[15] else 0bz,
		if(GPIO_1_d0[14]) GPIO_1_i0[14] else 0bz,
		if(GPIO_1_d0[13]) GPIO_1_i0[13] else 0bz,
		if(GPIO_1_d0[12]) GPIO_1_i0[12] else 0bz,
		if(GPIO_1_d0[11]) GPIO_1_i0[11] else 0bz,
		if(GPIO_1_d0[10]) GPIO_1_i0[10] else 0bz,
		if(GPIO_1_d0[9]) GPIO_1_i0[9] else 0bz,
		if(GPIO_1_d0[8]) GPIO_1_i0[8] else 0bz,
		if(GPIO_1_d0[7]) GPIO_1_i0[7] else 0bz,
		if(GPIO_1_d0[6]) GPIO_1_i0[6] else 0bz,
		if(GPIO_1_d0[5]) GPIO_1_i0[5] else 0bz,
		if(GPIO_1_d0[4]) GPIO_1_i0[4] else 0bz,
		if(GPIO_1_d0[3]) GPIO_1_i0[3] else 0bz,
		if(GPIO_1_d0[2]) GPIO_1_i0[2] else 0bz,
		if(GPIO_1_d0[1]) GPIO_1_i0[1] else 0bz,
		if(GPIO_1_d0[0]) GPIO_1_i0[0] else 0bz
		};
}
